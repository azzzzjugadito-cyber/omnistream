# OmniStream OTT - Configuración de Entorno
PORT=3001
HOST=0.0.0.0

# Clave de API de The Movie Database (TMDB)
# Consíguela gratis en https://www.themoviedb.org/settings/api
# Si se deja vacía, el sistema usa automáticamente Cinemeta como fallback sin necesidad de registro.
TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE

# TheSportsDB API Key (por defecto usa la clave pública de pruebas '123')
THESPORTSDB_API_KEY=123

# Nivel de log: info | debug | warn | error
LOG_LEVEL=info

# Intervalo del comprobador de salud en minutos
HEALTH_CHECK_INTERVAL_MINUTES=5
